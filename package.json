{
  "name": "darc-wiki",
  "private": true,
  "description": "The DARC wiki: its content, and a kit to preview and check it locally.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preview": "vite --config kit/vite.config.ts",
    "check": "tsx kit/cli.ts check",
    "fmt": "tsx kit/cli.ts fmt",
    "new-demo": "tsx kit/cli.ts new-demo"
  },
  "dependencies": {
    "katex": "0.19.0",
    "mdast-util-to-markdown": "2.2.0",
    "node-diff3": "3.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@types/mdast": "4.0.4",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  },
  "overrides": {
    "katex": "$katex",
    "postcss": "8.5.28",
    "rolldown": "1.2.12"
  }
}
